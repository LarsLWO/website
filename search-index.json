---
layout: null
permalink: /search-index.json
sitemap: false
---
[
{% assign searchable_texts = site.texts %}
{% for text in searchable_texts %}
  {
    "url": {{ text.url | relative_url | jsonify }},
    "content": {% if text.songtext %}{% assign searchable_songtext = text.songtext | markdownify | strip_html %}{% assign searchable_content = text.content | markdownify | strip_html | append: ' Songtext ' | append: searchable_songtext %}{% else %}{% assign searchable_content = text.content | markdownify | strip_html %}{% endif %}{{ searchable_content | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
